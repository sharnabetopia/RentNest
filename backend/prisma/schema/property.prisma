model Property {
    id String @id @default(uuid())

    title String

    description String

    address String
    city    String

    rent Decimal @db.Decimal(10, 2)

    bedrooms Int

    bathrooms Int

    amenities String[]

    images String[]

    status PropertyStatus @default(AVAILABLE)

    landlordId String

    categoryId String

    landlord User @relation(fields: [landlordId], references: [id])

    category Category @relation(fields: [categoryId], references: [id])

    rentals RentalRequest[]

    reviews Review[]

    createdAt DateTime @default(now())

    updatedAt DateTime @updatedAt

    @@index([city])
    @@index([status])
    @@index([categoryId])
    @@index([landlordId])

    @@map("Properties")
}
